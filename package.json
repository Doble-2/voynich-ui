{
  "name": "voynich-ui",
  "version": "0.1.0",
  "description": "A mystical React component library inspired by the Voynich Manuscript. Medieval aesthetics, modern performance, occult interactions.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Doble-2/voynich-ui.git"
  },
  "homepage": "https://doble-2.github.io/voynich-ui",
  "bugs": {
    "url": "https://github.com/Doble-2/voynich-ui/issues"
  },
  "scripts": {
    "dev": "tsup --watch & tailwindcss -i ./src/style.css -o ./dist/style.css --watch",
    "build": "tsup && tailwindcss -i ./src/style.css -o ./dist/style.css --minify",
    "test": "echo \"Error: no test specified\" && exit 1",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "voynich",
    "manuscript",
    "mystical",
    "medieval",
    "design-system",
    "tailwind",
    "gsap",
    "animation",
    "three",
    "r3f"
  ],
  "author": "Doble2",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@storybook/addon-a11y": "^10.2.16",
    "@storybook/addon-docs": "^10.2.16",
    "@storybook/addon-vitest": "^10.2.16",
    "@storybook/react-vite": "^10.2.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.19",
    "playwright": "^1.58.2",
    "postcss": "^8.4.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.2.16",
    "tailwindcss": "^3.4.4",
    "tsup": "^8.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "tailwind-merge": "^2.3.0",
    "three": "^0.186.1"
  }
}
